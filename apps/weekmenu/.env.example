# Weekmenu — omgevingsvariabelen
#
# Zonder deze variabelen draait de app in DEMO-MODE:
# alle referentiedata komt uit de seed en huishouddata wordt lokaal
# opgeslagen in .data/demo.json. Er is dan geen externe dienst nodig.
#
# Zet DATA_ADAPTER=supabase én de twee sleutels hieronder om over te
# schakelen naar een echt Supabase-project (zie DATABASE.md).

DATA_ADAPTER=demo
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
